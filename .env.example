# OpenWeatherMap - 실시간 날씨 및 단기 예보
# https://openweathermap.org/api 에서 발급
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# 공공데이터포털(data.go.kr) - 한국전력거래소 지역별 시간별 태양광 발전량
# https://www.data.go.kr 에서 발급 (URL 디코딩된 일반 인증키를 입력한다)
VITE_DATA_GO_KR_API_KEY=your_data_go_kr_api_key

# 오피넷(Opinet) - 전국/지역별 평균 유가
# https://www.opinet.co.kr/user/custApi/custApiInfo.do 에서 발급
VITE_OPINET_API_KEY=your_opinet_api_key

# Open-Meteo(일사량, 대기질)와 Frankfurter(환율)는 API 키가 필요 없다.
